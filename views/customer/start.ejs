<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Selamat Datang - Sejiwa Coffee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #2c3e50; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .welcome-card { border: none; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); max-width: 400px; width: 100%; }
    </style>
</head>
<body>

<div class="container p-3">
    <div class="card welcome-card p-4 mx-auto text-center bg-white">
        <div class="mb-3">
            <i class="fa-solid fa-mug-hot fa-3x text-warning mb-2"></i>
            <h3 class="fw-bold m-0 text-dark">SEJIWA COFFEE</h3>
            <p class="text-muted small">Selamat Datang 👋</p>
        </div>

        <form action="/customer/start" method="POST">
            <input type="hidden" name="table_id" value="<%= table.id %>">
            <input type="hidden" name="qr_token" value="<%= table.qr_token %>">

            <div class="mb-3 text-start">
                <label class="form-label fw-bold small text-muted">Nomor Meja Anda</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-chair"></i></span>
                    <input type="text" class="form-control fw-bold bg-light" value="MEJA <%= table.table_number %>" readonly>
                </div>
            </div>

            <div class="mb-4 text-start">
                <label class="form-label fw-bold small">Nama Pemesan</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                    <input type="text" name="customer_name" class="form-control" placeholder="Masukkan nama Anda..." required autofocus autocomplete="off">
                </div>
            </div>

            <button type="submit" class="btn btn-warning w-100 py-3 fw-bold text-dark shadow-sm">
                MULAI PESAN <i class="fa-solid fa-arrow-right ms-2"></i>
            </button>
        </form>
    </div>
</div>

</body>
</html>