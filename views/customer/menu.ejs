<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu - Sejiwa Coffee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; padding-bottom: 90px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .category-scroll { overflow-x: auto; whitespace: nowrap; scrollbar-width: none; }
        .category-scroll::-webkit-scrollbar { display: none; }
        .menu-card { border: none; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); transition: transform 0.2s; }
        .menu-card:active { transform: scale(0.98); }
        .cart-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #1e293b; color: #fff; border-top-left-radius: 16px; border-top-right-radius: 16px; z-index: 1030; }
    </style>
</head>
<body>

<!-- Header Top Navbar -->
<nav class="navbar navbar-dark bg-dark sticky-top shadow-sm">
    <div class="container d-flex justify-content-between align-items-center">
        <a class="navbar-brand fw-bold m-0" href="#">
            <i class="fa-solid fa-mug-hot text-warning me-2"></i>Sejiwa Coffee
        </a>
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
            <i class="fa-solid fa-chair me-1"></i>Meja <%= table ? table.table_number : '-' %>
        </span>
    </div>
</nav>

<div class="container py-3">
    <!-- Halo Pelanggan -->
    <div class="bg-white p-3 rounded-3 shadow-sm mb-3 border">
        <h6 class="fw-bold m-0 text-dark">Selamat datang, <span class="text-primary"><%= customer ? customer.name : 'Pelanggan' %></span>! 👋</h6>
        <small class="text-muted">Pilih menu favorit Anda dan langsung pesan dari meja.</small>
    </div>

    <!-- Filter Kategori Scrollable -->
    <div class="category-scroll d-flex gap-2 mb-3 pb-1">
        <button class="btn btn-dark btn-sm rounded-pill px-3 fw-bold filter-btn active" onclick="filterCategory('all', this)">
            Semua
        </button>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold filter-btn" onclick="filterCategory('<%= cat.id %>', this)">
                    <%= cat.name %>
                </button>
            <% }); %>
        <% } %>
    </div>

    <!-- Daftar Katalog Menu dengan Foto -->
<div class="row g-3" id="menu-container">
    <% if (menus && menus.length > 0) { %>
        <% menus.forEach(item => { %>
            <div class="col-12 col-md-6 menu-item-card" data-category="<%= item.category_id %>">
                <div class="card menu-card p-2 bg-white h-100 d-flex flex-row align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <!-- Thumbnail Foto Menu -->
                        <img src="<%= item.image ? (item.image.startsWith('http') ? item.image : '/images/menus/' + item.image) : 'https://placehold.co/100x100/1e293b/ffffff?text=' + encodeURIComponent(item.name) %>" 
                             alt="<%= item.name %>" 
                             class="rounded-3 object-fit-cover shadow-sm" 
                             style="width: 70px; height: 70px; min-width: 70px;"
                             onerror="this.onerror=null; this.src='https://placehold.co/100x100/1e293b/ffffff?text=Sejiwa';">
                        
                        <div>
                            <h6 class="fw-bold m-0 text-dark"><%= item.name %></h6>
                            <p class="text-muted small m-0 mb-1"><%= item.description || 'Nikmat & khas Sejiwa' %></p>
                            <span class="fw-bold text-success fs-6">Rp <%= Number(item.price).toLocaleString('id-ID') %></span>
                        </div>
                    </div>
                    <div class="pe-2">
                        <button onclick="addToCart('<%= item.id %>', '<%= item.name %>', <%= item.price %>)" class="btn btn-warning text-dark fw-bold btn-sm rounded-pill px-3 shadow-sm">
                            <i class="fa-solid fa-plus me-1"></i>Tambah
                        </button>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="col-12">
            <div class="alert alert-secondary text-center py-4 rounded-3">Belum ada menu yang tersedia saat ini.</div>
        </div>
    <% } %>
</div>

<!-- Bottom Floating Cart Bar -->
<div class="cart-bar p-3 shadow-lg" id="cart-bar" style="display: none;">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <div class="small text-white-50"><span id="total-items">0</span> Item Dipilih</div>
            <h5 class="fw-bold text-warning m-0" id="total-price-text">Rp 0</h5>
        </div>
        <button onclick="openCartModal()" class="btn btn-success fw-bold px-4 py-2 rounded-pill shadow-sm">
            Lihat Pesanan <i class="fa-solid fa-arrow-right ms-1"></i>
        </button>
    </div>
</div>

<!-- Modal Rincian Keranjang -->
<div class="modal fade" id="cartModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-basket-shopping text-warning me-2"></i>Keranjang Pesanan</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="cart-items-list" class="mb-3"></div>

                <div class="border-top pt-2">
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>Subtotal</span>
                        <span id="modal-subtotal">Rp 0</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                        <span class="fw-bold text-dark fs-6">Total Tagihan:</span>
                        <h4 class="fw-bold text-success m-0" id="modal-total">Rp 0</h4>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                <button type="button" onclick="checkoutOrder()" id="btn-checkout" class="btn btn-success fw-bold px-4">
                    Checkout Sekarang <i class="fa-solid fa-check-circle ms-1"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let cart = [];
    let subtotal = 0;
    let tax = 0;
    let total = 0;

    const cartModal = new bootstrap.Modal(document.getElementById('cartModal'));

    function filterCategory(catId, btn) {
        document.querySelectorAll('.filter-btn').forEach(b => {
            b.classList.remove('btn-dark', 'active');
            b.classList.add('btn-outline-secondary');
        });
        btn.classList.remove('btn-outline-secondary');
        btn.classList.add('btn-dark', 'active');

        const items = document.querySelectorAll('.menu-item-card');
        items.forEach(item => {
            if (catId === 'all' || item.getAttribute('data-category') === catId) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });
    }

    function addToCart(menuId, name, price) {
        const existing = cart.find(i => i.menu_id === menuId);
        if (existing) {
            existing.qty += 1;
            existing.subtotal = existing.qty * existing.price;
        } else {
            cart.push({
                menu_id: menuId,
                name: name,
                price: Number(price),
                qty: 1,
                subtotal: Number(price),
                notes: ''
            });
        }
        updateCartUI();
    }

    function updateQty(menuId, delta) {
        const item = cart.find(i => i.menu_id === menuId);
        if (!item) return;

        item.qty += delta;
        if (item.qty <= 0) {
            cart = cart.filter(i => i.menu_id !== menuId);
        } else {
            item.subtotal = item.qty * item.price;
        }
        updateCartUI();
        renderCartModalList();
    }

    function updateNotes(menuId, value) {
        const item = cart.find(i => i.menu_id === menuId);
        if (item) {
            item.notes = value;
        }
    }

    function calculateTotals() {
        subtotal = cart.reduce((acc, curr) => acc + curr.subtotal, 0);
        tax = 0;
        total = subtotal + tax;
    }

    function updateCartUI() {
        calculateTotals();
        const cartBar = document.getElementById('cart-bar');
        const totalItems = cart.reduce((acc, curr) => acc + curr.qty, 0);

        if (cart.length > 0) {
            cartBar.style.display = 'block';
            document.getElementById('total-items').innerText = totalItems;
            document.getElementById('total-price-text').innerText = `Rp ${total.toLocaleString('id-ID')}`;
        } else {
            cartBar.style.display = 'none';
        }
    }

    function renderCartModalList() {
        const container = document.getElementById('cart-items-list');
        if (cart.length === 0) {
            container.innerHTML = '<div class="alert alert-secondary text-center">Keranjang Anda kosong.</div>';
            document.getElementById('btn-checkout').disabled = true;
            return;
        }

        document.getElementById('btn-checkout').disabled = false;
        let html = '';
        cart.forEach(item => {
            html += `
                <div class="border-bottom pb-2 mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="text-dark">${item.name}</strong>
                        <span class="fw-bold text-success">Rp ${item.subtotal.toLocaleString('id-ID')}</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <input type="text" class="form-control form-control-sm" placeholder="Catatan (misal: Less sugar)" value="${item.notes || ''}" onchange="updateNotes('${item.menu_id}', this.value)">
                        <div class="btn-group btn-group-sm">
                            <button onclick="updateQty('${item.menu_id}', -1)" class="btn btn-outline-danger py-0 px-2 fw-bold">-</button>
                            <span class="btn btn-light py-0 px-2 fw-bold disabled text-dark">${item.qty}</span>
                            <button onclick="updateQty('${item.menu_id}', 1)" class="btn btn-outline-success py-0 px-2 fw-bold">+</button>
                        </div>
                    </div>
                </div>
            `;
        });
        container.innerHTML = html;

        document.getElementById('modal-subtotal').innerText = `Rp ${subtotal.toLocaleString('id-ID')}`;
        document.getElementById('modal-total').innerText = `Rp ${total.toLocaleString('id-ID')}`;
    }

    function openCartModal() {
        renderCartModalList();
        cartModal.show();
    }

    async function checkoutOrder() {
    if (cart.length === 0) return alert('Keranjang masih kosong!');

    const btnCheckout = document.getElementById('btn-checkout');
    btnCheckout.disabled = true;
    btnCheckout.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Memproses...';

    try {
        const response = await fetch('/customer/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                items: cart,
                subtotal: subtotal,
                tax: tax,
                service_charge: 0,
                total: total
            })
        });

        const text = await response.text();
        let result;
        try {
            result = JSON.parse(text);
        } catch (e) {
            console.error("Respon server bukan JSON:", text);
            alert("Error Server: " + text.substring(0, 150));
            btnCheckout.disabled = false;
            btnCheckout.innerHTML = 'Checkout Sekarang <i class="fa-solid fa-check-circle ms-1"></i>';
            return;
        }

        if (result.success) {
            window.location.href = `/customer/order/${result.orderNumber}/summary`;
        } else {
            alert('Gagal checkout: ' + (result.message || 'Terjadi kesalahan'));
            btnCheckout.disabled = false;
            btnCheckout.innerHTML = 'Checkout Sekarang <i class="fa-solid fa-check-circle ms-1"></i>';
        }
    } catch (error) {
        console.error('Error checkout:', error);
        alert('Terjadi kesalahan jaringan: ' + error.message);
        btnCheckout.disabled = false;
        btnCheckout.innerHTML = 'Checkout Sekarang <i class="fa-solid fa-check-circle ms-1"></i>';
    }
}
</script>

</body>
</html>