<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu - Sejiwa Coffee</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #fafafa; padding-bottom: 100px; }
        .header-bg { background-color: #2c3e50; color: #fff; border-radius: 0 0 20px 20px; }
        .menu-card { border: none; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); transition: transform 0.2s; }
        .menu-card:hover { transform: translateY(-3px); }
        .menu-img { height: 140px; object-fit: cover; }
        .category-btn { border-radius: 20px; font-weight: 500; }
        .cart-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-top: 1px solid #e0e0e0; box-shadow: 0 -4px 10px rgba(0,0,0,0.1); z-index: 1000; }
    </style>
</head>
<body>

<!-- Header Info Pelanggan -->
<div class="header-bg p-4 mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold m-0"><i class="fa-solid fa-mug-hot text-warning me-2"></i>Sejiwa Coffee</h4>
            <small class="text-light">Halo, <strong><%= customer.name %></strong> 👋</small>
        </div>
        <span class="badge bg-warning text-dark fs-6 px-3 py-2">Meja <%= table.table_number %></span>
    </div>
</div>

<div class="container">
    <!-- Filter Kategori -->
    <div class="d-flex overflow-auto gap-2 pb-3 mb-2" id="category-bar">
        <button class="btn btn-dark category-btn active" onclick="filterCategory('all', this)">Semua</button>
        <% categories.forEach(cat => { %>
            <button class="btn btn-outline-dark category-btn" onclick="filterCategory('<%= cat.id %>', this)"><%= cat.name %></button>
        <% }) %>
    </div>

    <!-- Daftar Katalog Menu -->
    <div class="row g-3" id="menu-container">
        <% menus.forEach(menu => { %>
            <div class="col-6 col-md-4 col-lg-3 menu-item-col" data-category="<%= menu.category_id %>">
                <div class="card menu-card h-100">
                    <img src="/uploads/<%= menu.image || 'default.png' %>" class="card-img-top menu-img" alt="<%= menu.name %>" onerror="this.src='https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=500'">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="fw-bold mb-1 text-truncate"><%= menu.name %></h6>
                            <p class="text-muted small mb-2 text-truncate-2"><%= menu.description || '-' %></p>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fw-bold text-success">Rp <%= Number(menu.price).toLocaleString('id-ID') %></span>
                            <button class="btn btn-sm btn-primary rounded-circle" onclick="openDetailModal('<%= menu.id %>', '<%= menu.name %>', '<%= menu.price %>')">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<!-- Modal Detail Menu -->
<div class="modal fade" id="menuModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalMenuName">Detail Pesanan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalMenuId">
                <input type="hidden" id="modalMenuPrice">
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Catatan Khusus (Opsional)</label>
                    <input type="text" id="modalNotes" class="form-control" placeholder="Contoh: Less sugar, Less ice">
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Jumlah:</span>
                    <div class="input-group input-group-sm w-auto">
                        <button class="btn btn-outline-secondary" onclick="updateModalQty(-1)">-</button>
                        <input type="text" id="modalQty" class="form-control text-center" value="1" readonly style="width: 45px;">
                        <button class="btn btn-outline-secondary" onclick="updateModalQty(1)">+</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary w-100 fw-bold" onclick="addToCart()">
                    Tambah ke Keranjang — <span id="modalTotalPrice">Rp 0</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Floating Bottom Cart Bar -->
<div class="cart-bar p-3" id="cartBar" style="display: none;">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <small class="text-muted d-block"><span id="cartTotalItems">0</span> Item dipilih</small>
            <h5 class="fw-bold m-0 text-primary" id="cartGrandTotal">Rp 0</h5>
        </div>
        <button class="btn btn-success fw-bold px-4" onclick="checkoutOrder()">
            Checkout <i class="fa-solid fa-arrow-right ms-2"></i>
        </button>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    let cart = [];
    let menuModalInstance = new bootstrap.Modal(document.getElementById('menuModal'));

    // Filter Kategori
    function filterCategory(catId, btn) {
        document.querySelectorAll('.category-btn').forEach(b => b.classList.replace('btn-dark', 'btn-outline-dark'));
        btn.classList.replace('btn-outline-dark', 'btn-dark');

        document.querySelectorAll('.menu-item-col').forEach(col => {
            if (catId === 'all' || col.getAttribute('data-category') === catId) {
                col.style.display = 'block';
            } else {
                col.style.display = 'none';
            }
        });
    }

    // Modal Control
    function openDetailModal(id, name, price) {
        document.getElementById('modalMenuId').value = id;
        document.getElementById('modalMenuName').innerText = name;
        document.getElementById('modalMenuPrice').value = price;
        document.getElementById('modalNotes').value = '';
        document.getElementById('modalQty').value = 1;

        updateModalTotalPrice();
        menuModalInstance.show();
    }

    function updateModalQty(delta) {
        let qtyEl = document.getElementById('modalQty');
        let current = parseInt(qtyEl.value) + delta;
        if (current >= 1) {
            qtyEl.value = current;
            updateModalTotalPrice();
        }
    }

    function updateModalTotalPrice() {
        let price = parseFloat(document.getElementById('modalMenuPrice').value);
        let qty = parseInt(document.getElementById('modalQty').value);
        document.getElementById('modalTotalPrice').innerText = 'Rp ' + (price * qty).toLocaleString('id-ID');
    }

    // Logic Keranjang
    function addToCart() {
        let id = document.getElementById('modalMenuId').value;
        let name = document.getElementById('modalMenuName').innerText;
        let price = parseFloat(document.getElementById('modalMenuPrice').value);
        let qty = parseInt(document.getElementById('modalQty').value);
        let notes = document.getElementById('modalNotes').value;

        let existing = cart.find(item => item.menu_id === id && item.notes === notes);
        if (existing) {
            existing.qty += qty;
            existing.subtotal = existing.qty * price;
        } else {
            cart.push({
                menu_id: id,
                name: name,
                price: price,
                qty: qty,
                subtotal: price * qty,
                notes: notes
            });
        }

        menuModalInstance.hide();
        renderCartBar();
    }

    function renderCartBar() {
        let cartBar = document.getElementById('cartBar');
        if (cart.length === 0) {
            cartBar.style.display = 'none';
            return;
        }

        let totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
        let subtotal = cart.reduce((sum, item) => sum + item.subtotal, 0);
        let tax = subtotal * 0.1; // Pajak 10%
        let grandTotal = subtotal + tax;

        document.getElementById('cartTotalItems').innerText = totalQty;
        document.getElementById('cartGrandTotal').innerText = 'Rp ' + grandTotal.toLocaleString('id-ID');
        cartBar.style.display = 'block';
    }

    // Checkout AJAX Engine
    async function checkoutOrder() {
        if (cart.length === 0) return;

        let subtotal = cart.reduce((sum, item) => sum + item.subtotal, 0);
        let tax = subtotal * 0.1;
        let total = subtotal + tax;

        try {
            const response = await fetch('/customer/checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    items: cart,
                    subtotal: subtotal,
                    tax: tax,
                    service_charge: 0,
                    total: total
                })
            });

            const result = await response.json();
            if (result.success) {
                window.location.href = `/customer/payment/${result.orderNumber}`;
            } else {
                alert('Gagal checkout: ' + result.message);
            }
        } catch (error) {
            alert('Terjadi kesalahan jaringan.');
        }
    }
</script>
</body>
</html>