<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Pesanan - Sejiwa Coffee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .summary-card { border: none; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); }
        .menu-item-row { border-bottom: 1px dashed #e2e8f0; }
        .menu-item-row:last-child { border-bottom: none; }
    </style>
</head>
<body>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <!-- Header -->
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark m-0"><i class="fa-solid fa-mug-hot text-warning me-2"></i>Sejiwa Coffee</h3>
                <small class="text-muted">Konfirmasi & Detail Pesanan Anda</small>
            </div>

            <!-- Kartu Ringkasan -->
            <div class="card summary-card p-4 bg-white mb-4">
                <!-- Info Pelanggan & Meja -->
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                    <div>
                        <span class="badge bg-secondary mb-1">#<%= order.order_number %></span>
                        <h5 class="fw-bold text-dark m-0"><%= order.customer_name %></h5>
                    </div>
                    <span class="badge bg-dark fs-6 px-3 py-2">Meja <%= order.table_number %></span>
                </div>

                <!-- Daftar Item Pesanan -->
                <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-list-check me-2 text-primary"></i>Rincian Menu:</h6>
                <div class="mb-3">
                    <% if (items && items.length > 0) { %>
                        <% items.forEach(item => { %>
                            <div class="menu-item-row py-2 d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-bold text-dark">
                                        <span class="text-primary me-1"><%= item.quantity %>x</span> <%= item.menu_name %>
                                    </div>
                                    <% if (item.notes) { %>
                                        <small class="text-danger fst-italic d-block">*( <%= item.notes %> )</small>
                                    <% } %>
                                </div>
                                <span class="fw-semibold text-dark ms-2">Rp <%= Number(item.subtotal).toLocaleString('id-ID') %></span>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- Rincian Biaya -->
                <div class="border-top pt-3">
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>Subtotal</span>
                        <span>Rp <%= Number(order.subtotal || order.total).toLocaleString('id-ID') %></span>
                    </div>
                    <% if (order.tax && order.tax > 0) { %>
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Pajak</span>
                            <span>Rp <%= Number(order.tax).toLocaleString('id-ID') %></span>
                        </div>
                    <% } %>
                    <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                        <span class="fw-bold fs-6 text-dark">Total Bayar:</span>
                        <h3 class="fw-bold text-success m-0">Rp <%= Number(order.total).toLocaleString('id-ID') %></h3>
                    </div>
                </div>
            </div>

            <!-- Tombol Aksi Lanjut Pembayaran -->
            <a href="/customer/payment/<%= order.order_number %>" class="btn btn-primary w-100 py-3 fw-bold fs-6 shadow-sm rounded-3">
                <i class="fa-solid fa-qrcode me-2"></i>Lanjut ke Pembayaran
            </a>
        </div>
    </div>
</div>

</body>
</html>