<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Riwayat Pesanan - Sejiwa Coffee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; min-height: 100vh; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { width: 240px; min-height: 100vh; background: #1e293b; }
        .sidebar .nav-link, .offcanvas-body .nav-link { color: #94a3b8; padding: 12px 20px; font-weight: 500; border-radius: 8px; margin-bottom: 4px; }
        .sidebar .nav-link.active, .sidebar .nav-link:hover,
        .offcanvas-body .nav-link.active, .offcanvas-body .nav-link:hover { color: #fff; background: #334155; }
        .content { flex: 1; width: 100%; max-width: 100%; overflow-x: hidden; }
    </style>
</head>
<body>

<!-- Mobile Header / Topbar Navbar -->
<nav class="navbar navbar-dark bg-dark d-md-none sticky-top shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-warning" href="#">
            <i class="fa-solid fa-mug-hot me-2"></i>SEJIWA
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</nav>

<!-- Mobile Offcanvas Sidebar Drawer -->
<div class="offcanvas offcanvas-start bg-dark text-white" id="mobileSidebar" tabindex="-1">
    <div class="offcanvas-header border-bottom border-secondary">
        <h5 class="offcanvas-title text-warning fw-bold"><i class="fa-solid fa-mug-hot me-2"></i>SEJIWA</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-3">
        <ul class="nav flex-column gap-1">
            <li class="nav-item">
                <a class="nav-link" href="/admin/dashboard"><i class="fa-solid fa-chart-line me-2"></i>Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="/admin/orders/history"><i class="fa-solid fa-clock-rotate-left me-2"></i>Riwayat Pesanan</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/menu"><i class="fa-solid fa-utensils me-2"></i>Kelola Menu</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/tables"><i class="fa-solid fa-qrcode me-2"></i>Kelola Meja & QR</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-danger mt-4" href="/admin/logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</a>
            </li>
        </ul>
    </div>
</div>

<div class="d-flex">
    <!-- Desktop Sidebar Navigasi -->
    <div class="sidebar p-3 d-none d-md-block">
        <div class="text-center mb-4 pt-2">
            <h4 class="text-warning fw-bold m-0"><i class="fa-solid fa-mug-hot me-2"></i>SEJIWA</h4>
            <small class="text-white-50">Cashier System</small>
        </div>
        <ul class="nav flex-column gap-1">
            <li class="nav-item">
                <a class="nav-link" href="/admin/dashboard"><i class="fa-solid fa-chart-line me-2"></i>Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="/admin/orders/history"><i class="fa-solid fa-clock-rotate-left me-2"></i>Riwayat Pesanan</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/menu"><i class="fa-solid fa-utensils me-2"></i>Kelola Menu</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/tables"><i class="fa-solid fa-qrcode me-2"></i>Kelola Meja & QR</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-danger mt-4" href="/admin/logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</a>
            </li>
        </ul>
    </div>

    <!-- Main Content Area -->
    <div class="content p-3 p-md-4">
        <div class="mb-4">
            <h3 class="fw-bold m-0 text-dark">Riwayat Pesanan</h3>
            <small class="text-muted">Arsip seluruh transaksi dan pesanan pelanggan</small>
        </div>

        <!-- Tabel Riwayat Pesanan -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead class="table-light">
                        <tr>
                            <th>No. Order</th>
                            <th>Pelanggan</th>
                            <th>Meja</th>
                            <th>Total</th>
                            <th>Status Pembayaran</th>
                            <th>Status Pesanan</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders && orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td><span class="badge bg-secondary">#<%= order.order_number %></span></td>
                                    <td class="fw-bold text-dark"><%= order.customer_name %></td>
                                    <td>Meja <%= order.table_number %></td>
                                    <td class="fw-bold text-success">Rp <%= Number(order.total).toLocaleString('id-ID') %></td>
                                    <td>
                                        <span class="badge <%= order.payment_status === 'PAID' ? 'bg-success' : 'bg-warning text-dark' %>">
                                            <%= order.payment_status %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge <%= order.order_status === 'COMPLETED' ? 'bg-success' : 'bg-primary' %>">
                                            <%= order.order_status %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a href="/admin/order/<%= order.id %>/detail" class="btn btn-sm btn-outline-dark fw-bold">
                                            <i class="fa-solid fa-eye"></i> Detail
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Belum ada riwayat pesanan.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>