<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Kasir - Sejiwa Coffee</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar { min-height: 100vh; background-color: #2c3e50; color: #fff; }
        .sidebar a { color: #ecf0f1; text-decoration: none; padding: 12px 20px; display: block; }
        .sidebar a:hover, .sidebar a.active { background-color: #34495e; border-left: 4px solid #e67e22; }
        .card-stat { border: none; border-radius: 12px; transition: transform 0.2s; }
        .card-stat:hover { transform: translateY(-3px); }
        .table-responsive { background: #fff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .toast-container { z-index: 9999; }
    </style>
</head>
<body>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Navigation -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-0">
            <div class="p-3 text-center border-bottom border-secondary">
                <h4 class="fw-bold m-0 text-warning"><i class="fa-solid fa-mug-hot me-2"></i>SEJIWA</h4>
                <small class="text-muted">Cashier System</small>
            </div>
            <div class="py-3">
                <a href="/admin/dashboard" class="active"><i class="fa-solid fa-chart-line me-2"></i> Dashboard</a>
                <a href="/admin/orders/history"><i class="fa-solid fa-clock-rotate-left me-2"></i> Riwayat Pesanan</a>
                <a href="/admin/menu"><i class="fa-solid fa-utensils me-2"></i> Kelola Menu</a>
                <a href="/admin/tables"><i class="fa-solid fa-qrcode me-2"></i> Kelola Meja & QR</a>
                <a href="/admin/logout" class="text-danger mt-4"><i class="fa-solid fa-right-from-bracket me-2"></i> Logout</a>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
                <h1 class="h3 fw-bold">Dashboard Operational Kasir</h1>
                <span class="badge bg-success p-2"><i class="fa-solid fa-wifi me-1"></i> Realtime Socket Active</span>
            </div>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card card-stat bg-warning text-dark p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-uppercase mb-1 fs-7 fw-bold">Verifikasi Bayar</h6>
                                <h2 class="m-0 fw-bold" id="stat-verify"><%= summary.waiting_verify || 0 %></h2>
                            </div>
                            <i class="fa-solid fa-receipt fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card card-stat bg-info text-white p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-uppercase mb-1 fs-7 fw-bold">Sedang Diproses</h6>
                                <h2 class="m-0 fw-bold" id="stat-processing"><%= summary.processing || 0 %></h2>
                            </div>
                            <i class="fa-solid fa-fire fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card card-stat bg-primary text-white p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-uppercase mb-1 fs-7 fw-bold">Pesanan Siap</h6>
                                <h2 class="m-0 fw-bold" id="stat-ready"><%= summary.ready || 0 %></h2>
                            </div>
                            <i class="fa-solid fa-bell fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card card-stat bg-success text-white p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-uppercase mb-1 fs-7 fw-bold">Selesai Hari Ini</h6>
                                <h2 class="m-0 fw-bold" id="stat-completed"><%= summary.completed || 0 %></h2>
                            </div>
                            <i class="fa-solid fa-check-double fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Table -->
            <h4 class="fw-bold mb-3">Daftar Pesanan Masuk</h4>
            <div class="table-responsive p-3">
                <table class="table table-hover align-middle mb-0" id="orders-table">
                    <thead class="table-light">
                        <tr>
                            <th>Order ID</th>
                            <th>Pelanggan</th>
                            <th>Meja</th>
                            <th>Total</th>
                            <th>Status Pembayaran</th>
                            <th>Status Pesanan</th>
                            <th class="text-end">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="orders-list">
                        <% if(orders.length === 0) { %>
                            <tr id="empty-row"><td colspan="7" class="text-center py-4 text-muted">Belum ada pesanan aktif saat ini.</td></tr>
                        <% } else { %>
                            <% orders.forEach(order => { %>
                                <tr id="order-row-<%= order.id %>">
                                    <td class="fw-bold text-primary">#<%= order.order_number %></td>
                                    <td><%= order.customer_name %></td>
                                    <td><span class="badge bg-secondary">Meja <%= order.table_number %></span></td>
                                    <td class="fw-bold">Rp <%= Number(order.total).toLocaleString('id-ID') %></td>
                                    <td>
                                        <% if(order.payment_status === 'WAITING_VERIFICATION') { %>
                                            <span class="badge bg-warning text-dark">Menunggu Verifikasi</span>
                                        <% } else if(order.payment_status === 'PAID') { %>
                                            <span class="badge bg-success">Lunas</span>
                                        <% } else { %>
                                            <span class="badge bg-danger"><%= order.payment_status %></span>
                                        <% } %>
                                    </td>
                                    <td><span class="badge bg-info text-dark"><%= order.order_status %></span></td>
                                    <td class="text-end">
                                        <% if(order.payment_status === 'WAITING_VERIFICATION') { %>
                                            <button class="btn btn-sm btn-success me-1" onclick="verifyPayment('<%= order.id %>', 'approve')"><i class="fa-solid fa-check"></i> Terima</button>
                                            <button class="btn btn-sm btn-danger me-1" onclick="verifyPayment('<%= order.id %>', 'reject')"><i class="fa-solid fa-xmark"></i> Tolak</button>
                                        <% } else if(order.order_status === 'PROCESSING') { %>
                                            <button class="btn btn-sm btn-primary me-1" onclick="updateStatus('<%= order.id %>', 'READY')">Siap</button>
                                        <% } else if(order.order_status === 'READY') { %>
                                            <button class="btn btn-sm btn-success me-1" onclick="updateStatus('<%= order.id %>', 'COMPLETED')">Selesai</button>
                                        <% } %>
                                        <a href="/admin/orders/<%= order.id %>/print" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-print"></i></a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<!-- Socket.IO Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="orderToast" class="toast align-items-center text-white bg-dark border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fs-6" id="toast-message">
                <i class="fa-solid fa-bell text-warning me-2"></i> Pesanan Baru Masuk!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<!-- Audio Notification -->
<audio id="notif-sound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

<!-- Bootstrap JS & Socket.IO Client -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const notifSound = document.getElementById('notif-sound');
    const toastEl = document.getElementById('orderToast');
    const toast = new bootstrap.Toast(toastEl);

    // 1. Socket Listener: Pesanan Baru Masuk
    socket.on('new_order', (data) => {
        // Play Sound & Show Toast
        notifSound.play().catch(e => console.log('Audio autoplay blocked'));
        document.getElementById('toast-message').innerHTML = `
            <i class="fa-solid fa-bell text-warning me-2"></i> 
            <strong>#${data.order_number}</strong> - Meja ${data.table_number} (Rp ${Number(data.total).toLocaleString('id-ID')})
        `;
        toast.show();

        // Hapus empty row jika ada
        const emptyRow = document.getElementById('empty-row');
        if(emptyRow) emptyRow.remove();

        // Dynamically Append Row Baru ke Atas Tabel
        const ordersList = document.getElementById('orders-list');
        const newRow = document.createElement('tr');
        newRow.id = `order-row-${data.order_id}`;
        newRow.className = 'table-warning'; // Highlight row baru
        newRow.innerHTML = `
            <td class="fw-bold text-primary">#${data.order_number}</td>
            <td>${data.customer_name}</td>
            <td><span class="badge bg-secondary">Meja ${data.table_number}</span></td>
            <td class="fw-bold">Rp ${Number(data.total).toLocaleString('id-ID')}</td>
            <td><span class="badge bg-warning text-dark">Menunggu Verifikasi</span></td>
            <td><span class="badge bg-info text-dark">PENDING</span></td>
            <td class="text-end">
                <button class="btn btn-sm btn-success me-1" onclick="verifyPayment('${data.order_id}', 'approve')"><i class="fa-solid fa-check"></i> Terima</button>
                <button class="btn btn-sm btn-danger me-1" onclick="verifyPayment('${data.order_id}', 'reject')"><i class="fa-solid fa-xmark"></i> Tolak</button>
                <a href="/admin/orders/${data.order_id}/print" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-print"></i></a>
            </td>
        `;
        ordersList.insertBefore(newRow, ordersList.firstChild);

        // Update Stat Counter
        const verifyStat = document.getElementById('stat-verify');
        verifyStat.innerText = parseInt(verifyStat.innerText) + 1;
    });

    // 2. Socket Listener: Refresh status bila ada pembaruan
    socket.on('order_status_updated', () => {
        window.location.reload();
    });

    // AJAX Action: Verifikasi Pembayaran
    async function verifyPayment(orderId, action) {
        if(!confirm(`Apakah Anda yakin ingin ${action === 'approve' ? 'MENERIMA' : 'MENOLAK'} pembayaran ini?`)) return;
        
        try {
            const res = await fetch(`/admin/orders/${orderId}/verify`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action })
            });
            const data = await res.json();
            if(data.success) window.location.reload();
        } catch (err) {
            alert('Gagal memproses verifikasi');
        }
    }

    // AJAX Action: Update Status Pesanan (READY/COMPLETED)
    async function updateStatus(orderId, status) {
        try {
            const res = await fetch(`/admin/orders/${orderId}/status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            });
            const data = await res.json();
            if(data.success) window.location.reload();
        } catch (err) {
            alert('Gagal memperbarui status');
        }
    }
</script>
</body>
</html>