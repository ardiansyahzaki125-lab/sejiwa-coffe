<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Menu - Sejiwa Coffee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; min-height: 100vh; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { width: 240px; min-height: 100vh; background: #1e293b; }
        .sidebar .nav-link { color: #94a3b8; padding: 12px 20px; font-weight: 500; border-radius: 8px; margin-bottom: 4px; }
        .sidebar .nav-link.active, .sidebar .nav-link:hover { color: #fff; background: #334155; }
        .content { flex: 1; }
    </style>
</head>
<body>

<div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar p-3 d-none d-md-block">
        <div class="text-center mb-4 pt-2">
            <h4 class="text-warning fw-bold m-0"><i class="fa-solid fa-mug-hot me-2"></i>SEJIWA</h4>
            <small class="text-white-50">Cashier System</small>
        </div>
        <ul class="nav flex-column gap-1">
            <li class="nav-item">
                <a class="nav-link" href="/admin/dashboard"><i class="fa-solid fa-chart-line me-2"></i>Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/orders/history"><i class="fa-solid fa-clock-rotate-left me-2"></i>Riwayat Pesanan</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="/admin/menus"><i class="fa-solid fa-utensils me-2"></i>Kelola Menu</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/tables"><i class="fa-solid fa-qrcode me-2"></i>Kelola Meja & QR</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-danger mt-4" href="/admin/logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</a>
            </li>
        </ul>
    </div>

    <!-- Content -->
    <div class="content p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold m-0 text-dark">Kelola Menu Makanan & Minuman</h3>
                <small class="text-muted">Daftar item menu yang tampil di HP pelanggan</small>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nama Menu</th>
                            <th>Kategori</th>
                            <th>Harga</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (menus && menus.length > 0) { %>
                            <% menus.forEach(item => { %>
                                <tr>
                                    <td>#<%= item.id %></td>
                                    <td class="fw-bold"><%= item.name %></td>
                                    <td><span class="badge bg-secondary"><%= item.category_name || 'Umum' %></span></td>
                                    <td class="fw-bold text-success">Rp <%= Number(item.price).toLocaleString('id-ID') %></td>
                                    <td>
                                        <span class="badge <%= item.status === 'available' ? 'bg-success' : 'bg-danger' %>">
                                            <%= item.status === 'available' ? 'Tersedia' : 'Habis' %>
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="5" class="text-center py-4 text-muted">Belum ada item menu.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

</body>
</html>