<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Code Meja <%= table.table_number %> - Sejiwa Coffee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .qr-card {
            max-width: 380px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            background: #fff;
            border: 3px solid #1e293b;
        }
        @media print {
            .no-print { display: none !important; }
            body { background: #fff; }
            .qr-card { box-shadow: none; border: 2px solid #000; margin: auto; }
        }
    </style>
</head>
<body>

<div class="container py-5 text-center">
    <!-- Tombol Aksi (Sembunyi saat dicetak) -->
    <div class="mb-4 no-print d-flex justify-content-center gap-2">
        <a href="/admin/tables" class="btn btn-secondary fw-bold"><i class="fa-solid fa-arrow-left me-1"></i>Kembali</a>
        <button onclick="window.print()" class="btn btn-primary fw-bold"><i class="fa-solid fa-print me-1"></i>Cetak QR Code</button>
    </div>

    <!-- Tampilan Kartu QR Meja -->
    <div class="card qr-card mx-auto p-4 text-center">
        <div class="mb-3">
            <h3 class="fw-bold text-dark m-0"><i class="fa-solid fa-mug-hot text-warning me-2"></i>SEJIWA COFFEE</h3>
            <small class="text-muted fw-semibold">Self-Ordering System</small>
        </div>

        <div class="bg-dark text-white rounded-3 py-2 mb-3">
            <h2 class="fw-bold m-0">MEJA <%= table.table_number %></h2>
        </div>

        <!-- QR Code Generator via QuickChart API -->
        <div class="my-3 p-3 border rounded-3 bg-light d-inline-block mx-auto">
            <img src="https://quickchart.io/qr?text=<%= encodeURIComponent(scanUrl) %>&size=250&margin=1" alt="QR Code Meja <%= table.table_number %>" class="img-fluid rounded" style="width: 220px; height: 220px;">
        </div>

        <p class="fw-bold text-dark m-0 mt-2"><i class="fa-solid fa-camera me-1 text-primary"></i>SCAN UNTUK PESAN MENU</p>
        <small class="text-muted small">Arahkan kamera HP Anda ke QR Code di atas untuk memilih menu & memesan.</small>
    </div>
</div>

</body>
</html>