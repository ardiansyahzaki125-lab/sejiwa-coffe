<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Nota #<%= order.order_number %></title>
    <style>
        * { font-family: 'Courier New', Courier, monospace; font-size: 12px; margin: 0; padding: 0; }
        .receipt { width: 80mm; padding: 10px; margin: auto; }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .line { border-bottom: 1px dashed #000; margin: 8px 0; }
        .flex { display: flex; justify-content: space-between; }
        @media print {
            body { margin: 0; }
            .no-print { display: none; }
        }
    </style>
</head>
<body onload="window.print()">

<div class="receipt">
    <div class="text-center">
        <h2>SEJIWA COFFEE</h2>
        <p>Coffee • Food • Drink</p>
    </div>

    <div class="line"></div>

    <div>Order  : #<%= order.order_number %></div>
    <div>Tanggal: <%= new Date(order.created_at).toLocaleString('id-ID') %></div>
    <div>Nama   : <%= order.customer_name %></div>
    <div>Meja   : <%= order.table_number %></div>

    <div class="line"></div>

    <% items.forEach(item => { %>
        <div>
            <div><%= item.quantity %>x <%= item.menu_name %></div>
            <div class="text-right">Rp <%= Number(item.subtotal).toLocaleString('id-ID') %></div>
        </div>
    <% }) %>

    <div class="line"></div>

    <div class="flex">
        <span>Subtotal:</span>
        <span>Rp <%= Number(order.subtotal).toLocaleString('id-ID') %></span>
    </div>
    <div class="flex">
        <span>Pajak (10%):</span>
        <span>Rp <%= Number(order.tax).toLocaleString('id-ID') %></span>
    </div>

    <div class="line"></div>

    <div class="flex" style="font-weight: bold; font-size: 14px;">
        <span>TOTAL:</span>
        <span>Rp <%= Number(order.total).toLocaleString('id-ID') %></span>
    </div>

    <div class="line"></div>

    <div class="flex">
        <span>Pembayaran:</span>
        <span><%= order.payment_method %></span>
    </div>
    <div class="flex">
        <span>Status:</span>
        <span><%= order.payment_status === 'PAID' ? 'LUNAS' : order.payment_status %></span>
    </div>

    <div class="line"></div>

    <div class="text-center" style="margin-top: 15px;">
        <p>TERIMA KASIH</p>
        <p>SEJIWA COFFEE</p>
    </div>
</div>

<div class="no-print text-center" style="margin-top: 20px;">
    <button onclick="window.print()">Cetak Ulang</button>
</div>

</body>
</html>