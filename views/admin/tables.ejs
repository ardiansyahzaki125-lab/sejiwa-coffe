<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Meja & QR - Sejiwa Coffee</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar { min-height: 100vh; background-color: #2c3e50; color: #fff; }
        .sidebar a { color: #ecf0f1; text-decoration: none; padding: 12px 20px; display: block; }
        .sidebar a:hover, .sidebar a.active { background-color: #34495e; border-left: 4px solid #e67e22; }
        .card-table { border: none; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); transition: transform 0.2s; }
        .card-table:hover { transform: translateY(-3px); }
    </style>
</head>
<body>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Navigation -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-0">
            <div class="p-3 text-center border-bottom border-secondary">
                <h4 class="fw-bold m-0 text-warning"><i class="fa-solid fa-mug-hot me-2"></i>SEJIWA</h4>
                <small class="text-muted">Cashier System</small>
            </div>
            <div class="py-3">
                <a href="/admin/dashboard"><i class="fa-solid fa-chart-line me-2"></i> Dashboard</a>
                <a href="/admin/orders/history"><i class="fa-solid fa-clock-rotate-left me-2"></i> Riwayat Pesanan</a>
                <a href="/admin/menu"><i class="fa-solid fa-utensils me-2"></i> Kelola Menu</a>
                <a href="/admin/tables" class="active"><i class="fa-solid fa-qrcode me-2"></i> Kelola Meja & QR</a>
                <a href="/admin/logout" class="text-danger mt-4"><i class="fa-solid fa-right-from-bracket me-2"></i> Logout</a>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
                <h1 class="h3 fw-bold">Manajemen Meja & QR Code</h1>
                <button class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#addTableModal">
                    <i class="fa-solid fa-plus me-1"></i> Tambah Meja Baru
                </button>
            </div>

            <!-- Table Grid List -->
            <div class="row g-3">
                <% if(tables.length === 0) { %>
                    <div class="col-12 text-center py-5 text-muted">Belum ada meja yang terdaftar.</div>
                <% } else { %>
                    <% tables.forEach(t => { %>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="card card-table p-3 text-center bg-white">
                                <div class="mb-2">
                                    <span class="badge bg-secondary fs-6 px-3 py-2">MEJA <%= t.table_number %></span>
                                </div>
                                <small class="text-muted d-block text-truncate mb-3" style="font-size: 11px;">Token: <%= t.qr_token %></small>
                                
                                <div class="d-grid gap-2">
                                    <a href="/admin/tables/qr/<%= t.qr_token %>" target="_blank" class="btn btn-outline-primary btn-sm fw-bold">
                                        <i class="fa-solid fa-qrcode me-1"></i> Lihat / Cetak QR
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </main>
    </div>
</div>

<!-- Modal Tambah Meja -->
<div class="modal fade" id="addTableModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/admin/tables/create" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Tambah Meja Baru</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nomor / Identitas Meja</label>
                        <input type="text" name="table_number" class="form-control" placeholder="Contoh: 04, VIP-1, T-05" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary fw-bold">Generate QR Meja</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>