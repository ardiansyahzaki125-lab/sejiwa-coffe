<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Menu - Sejiwa Coffee</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar { min-height: 100vh; background-color: #2c3e50; color: #fff; }
        .sidebar a { color: #ecf0f1; text-decoration: none; padding: 12px 20px; display: block; }
        .sidebar a:hover, .sidebar a.active { background-color: #34495e; border-left: 4px solid #e67e22; }
        .menu-thumb { width: 50px; height: 50px; object-fit: cover; border-radius: 8px; }
        .table-responsive { background: #fff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    </style>
</head>
<body>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Navigation -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-0">
            <div class="p-3 text-center border-bottom border-secondary">
                <h4 class="fw-bold m-0 text-warning"><i class="fa-solid fa-mug-hot me-2"></i>SEJIWA</h4>
                <small class="text-muted">Cashier System</small>
            </div>
            <div class="py-3">
                <a href="/admin/dashboard"><i class="fa-solid fa-chart-line me-2"></i> Dashboard</a>
                <a href="/admin/orders/history"><i class="fa-solid fa-clock-rotate-left me-2"></i> Riwayat Pesanan</a>
                <a href="/admin/menu" class="active"><i class="fa-solid fa-utensils me-2"></i> Kelola Menu</a>
                <a href="/admin/tables"><i class="fa-solid fa-qrcode me-2"></i> Kelola Meja & QR</a>
                <a href="/admin/logout" class="text-danger mt-4"><i class="fa-solid fa-right-from-bracket me-2"></i> Logout</a>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
                <h1 class="h3 fw-bold">Manajemen Katalog Menu</h1>
                <button class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#addMenuModal">
                    <i class="fa-solid fa-plus me-1"></i> Tambah Menu Baru
                </button>
            </div>

            <!-- Table Card -->
            <div class="table-responsive p-3">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Foto</th>
                            <th>Nama Menu</th>
                            <th>Kategori</th>
                            <th>Harga</th>
                            <th>Status</th>
                            <th class="text-end">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(menus.length === 0) { %>
                            <tr><td colspan="6" class="text-center py-4 text-muted">Belum ada menu yang ditambahkan.</td></tr>
                        <% } else { %>
                            <% menus.forEach(menu => { %>
                                <tr>
                                    <td>
                                        <img src="/uploads/<%= menu.image || 'default.png' %>" class="menu-thumb" alt="<%= menu.name %>" onerror="this.src='https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=500'">
                                    </td>
                                    <td>
                                        <div class="fw-bold"><%= menu.name %></div>
                                        <small class="text-muted"><%= menu.description || '-' %></small>
                                    </td>
                                    <td><span class="badge bg-secondary"><%= menu.category_name %></span></td>
                                    <td class="fw-bold text-success">Rp <%= Number(menu.price).toLocaleString('id-ID') %></td>
                                    <td>
                                        <% if(menu.status === 'available') { %>
                                            <span class="badge bg-success">Tersedia</span>
                                        <% } else { %>
                                            <span class="badge bg-danger">Habis</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" onclick="openEditModal('<%= menu.id %>', '<%= menu.category_id %>', '<%= menu.name %>', '<%= menu.price %>', '<%= menu.status %>', `<%= menu.description || '' %>`)">
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </button>
                                        <form action="/admin/menu/delete/<%= menu.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus menu ini?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<!-- Modal Tambah Menu -->
<div class="modal fade" id="addMenuModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/admin/menu/create" method="POST" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Tambah Menu Baru</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nama Menu</label>
                        <input type="text" name="name" class="form-control" required placeholder="Contoh: Caramel Latte">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kategori</label>
                        <select name="category_id" class="form-select" required>
                            <option value="" disabled selected>-- Pilih Kategori --</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id %>"><%= cat.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Harga (Rp)</label>
                        <input type="number" name="price" class="form-control" required placeholder="Contoh: 28000">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Deskripsi</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Penjelasan singkat menu..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status Ketersediaan</label>
                        <select name="status" class="form-select">
                            <option value="available" selected>Tersedia</option>
                            <option value="empty">Habis</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Foto Produk (Opsional)</label>
                        <input type="file" name="image" class="form-control" accept="image/*">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary fw-bold">Simpan Menu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Menu -->
<div class="modal fade" id="editMenuModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editMenuForm" method="POST" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Edit Detail Menu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nama Menu</label>
                        <input type="text" id="editName" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kategori</label>
                        <select id="editCategory" name="category_id" class="form-select" required>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id %>"><%= cat.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Harga (Rp)</label>
                        <input type="number" id="editPrice" name="price" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Deskripsi</label>
                        <textarea id="editDescription" name="description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status Ketersediaan</label>
                        <select id="editStatus" name="status" class="form-select">
                            <option value="available">Tersedia</option>
                            <option value="empty">Habis</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ganti Foto Produk (Biarkan kosong jika tidak diubah)</label>
                        <input type="file" name="image" class="form-control" accept="image/*">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary fw-bold">Update Menu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const editModalInstance = new bootstrap.Modal(document.getElementById('editMenuModal'));

    function openEditModal(id, categoryId, name, price, status, description) {
        document.getElementById('editMenuForm').action = `/admin/menu/update/${id}`;
        document.getElementById('editName').value = name;
        document.getElementById('editCategory').value = categoryId;
        document.getElementById('editPrice').value = price;
        document.getElementById('editStatus').value = status;
        document.getElementById('editDescription').value = description;

        editModalInstance.show();
    }
</script>
</body>
</html>