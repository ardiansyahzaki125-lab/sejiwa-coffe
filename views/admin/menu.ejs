<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Menu - Sejiwa Coffee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; min-height: 100vh; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { width: 240px; min-height: 100vh; background: #1e293b; }
        .sidebar .nav-link { color: #94a3b8; padding: 12px 20px; font-weight: 500; border-radius: 8px; margin-bottom: 4px; }
        .sidebar .nav-link.active, .sidebar .nav-link:hover { color: #fff; background: #334155; }
        .content { flex: 1; }
        .nav-pills .nav-link { font-weight: 600; color: #475569; border-radius: 10px; padding: 8px 18px; }
        .nav-pills .nav-link.active { background-color: #1e293b; color: #fff; }
    </style>
</head>
<body>

<div class="d-flex">
    <!-- Sidebar Navigasi -->
    <div class="sidebar p-3 d-none d-md-block">
        <div class="text-center mb-4 pt-2">
            <h4 class="text-warning fw-bold m-0"><i class="fa-solid fa-mug-hot me-2"></i>SEJIWA</h4>
            <small class="text-white-50">Cashier System</small>
        </div>
        <ul class="nav flex-column gap-1">
            <li class="nav-item">
                <a class="nav-link" href="/admin/dashboard"><i class="fa-solid fa-chart-line me-2"></i>Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/orders/history"><i class="fa-solid fa-clock-rotate-left me-2"></i>Riwayat Pesanan</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="/admin/menu"><i class="fa-solid fa-utensils me-2"></i>Kelola Menu</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/tables"><i class="fa-solid fa-qrcode me-2"></i>Kelola Meja & QR</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-danger mt-4" href="/admin/logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</a>
            </li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="content p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold m-0 text-dark">Katalog Menu</h3>
                <small class="text-muted">Kelola daftar produk makanan & minuman Sejiwa Coffee</small>
            </div>
            <button class="btn btn-warning text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#addMenuModal">
                <i class="fa-solid fa-plus me-1"></i>Tambah Menu Baru
            </button>
        </div>

        <!-- Filter Tab Kategori Makanan & Minuman -->
        <ul class="nav nav-pills mb-3 bg-white p-2 rounded-3 shadow-sm d-inline-flex gap-2">
            <li class="nav-item">
                <button class="nav-link active" onclick="filterMenu('all', this)">
                    <i class="fa-solid fa-border-all me-1"></i>Semua Menu
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" onclick="filterMenu('minuman', this)">
                    <i class="fa-solid fa-mug-saucer me-1 text-primary"></i>Minuman
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" onclick="filterMenu('makanan', this)">
                    <i class="fa-solid fa-bowl-food me-1 text-warning"></i>Makanan
                </button>
            </li>
        </ul>

        <!-- Tabel Katalog Menu -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0" id="menuTable">
                    <thead class="table-light">
                        <tr>
                            <th>Foto</th>
                            <th>Jenis</th>
                            <th>Nama Menu</th>
                            <th>Kategori</th>
                            <th>Harga</th>
                            <th>Status Stok</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (menus && menus.length > 0) { %>
                            <% menus.forEach(item => { %>
                                <% 
                                    const catType = (item.category_type || '').toLowerCase();
                                    const catName = (item.category_name || '').toLowerCase();
                                    const isFood = catType === 'makanan' || catName.includes('makanan') || catName.includes('snack') || catName.includes('food');
                                    const itemType = isFood ? 'makanan' : 'minuman';
                                %>
                                <tr class="menu-row" data-type="<%= itemType %>">
                                    <td>
                                        <img src="<%= item.image ? (item.image.startsWith('http') ? item.image : '/images/menus/' + item.image) : 'https://placehold.co/100x100/1e293b/ffffff?text=' + encodeURIComponent(item.name) %>" 
                                             alt="<%= item.name %>" 
                                             class="rounded-2 object-fit-cover shadow-sm" 
                                             style="width: 45px; height: 45px;"
                                             onerror="this.onerror=null; this.src='https://placehold.co/100x100/1e293b/ffffff?text=Sejiwa';">
                                    </td>
                                    <td>
                                        <% if (isFood) { %>
                                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-bowl-food me-1"></i>Makanan</span>
                                        <% } else { %>
                                            <span class="badge bg-primary"><i class="fa-solid fa-mug-saucer me-1"></i>Minuman</span>
                                        <% } %>
                                    </td>
                                    <td class="fw-bold text-dark"><%= item.name %></td>
                                    <td><span class="badge bg-secondary"><%= item.category_name || 'Umum' %></span></td>
                                    <td class="fw-bold text-success">Rp <%= Number(item.price).toLocaleString('id-ID') %></td>
                                    <td>
                                        <span class="badge <%= item.status === 'available' ? 'bg-success' : 'bg-danger' %>">
                                            <%= item.status === 'available' ? 'Tersedia' : 'Habis' %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary me-1" onclick='openEditModal(<%- JSON.stringify(item) %>)' title="Edit">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteMenu('<%= item.id %>')" title="Hapus">
                                            <i class="fa-solid fa-trash"></i> Hapus
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="7" class="text-center py-4 text-muted">Belum ada item menu terdaftar.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tambah Menu -->
<div class="modal fade" id="addMenuModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus me-2"></i>Tambah Menu Baru</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addMenuForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nama Menu</label>
                        <input type="text" id="add_name" class="form-control" placeholder="Contoh: Espresso / Roti Bakar" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kategori</label>
                        <select id="add_category_id" class="form-select" required>
                            <option value="">-- Pilih Kategori --</option>
                            <% if (categories && categories.length > 0) { %>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat.id %>"><%= cat.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Harga (Rp)</label>
                        <input type="number" id="add_price" class="form-control" placeholder="25000" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Upload Foto / Gambar Menu</label>
                        <input type="file" id="add_image_file" class="form-control" accept="image/*">
                        <small class="text-muted">Pilih file gambar (.jpg, .png, .jpeg) dari komputer Anda.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status Stok</label>
                        <select id="add_status" class="form-select">
                            <option value="available">Tersedia</option>
                            <option value="unavailable">Habis</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-warning fw-bold">Simpan Menu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Menu -->
<div class="modal fade" id="editMenuModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen me-2"></i>Edit Menu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="editMenuForm" enctype="multipart/form-data">
                <input type="hidden" id="edit_id">
                <input type="hidden" id="edit_existing_image">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nama Menu</label>
                        <input type="text" id="edit_name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kategori</label>
                        <select id="edit_category_id" class="form-select" required>
                            <% if (categories && categories.length > 0) { %>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat.id %>"><%= cat.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Harga (Rp)</label>
                        <input type="number" id="edit_price" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ganti Foto Menu (Opsional)</label>
                        <input type="file" id="edit_image_file" class="form-control" accept="image/*">
                        <small class="text-muted">Biarkan kosong jika tidak ingin mengubah foto saat ini.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status Stok</label>
                        <select id="edit_status" class="form-select">
                            <option value="available">Tersedia</option>
                            <option value="unavailable">Habis</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary fw-bold">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const editModal = new bootstrap.Modal(document.getElementById('editMenuModal'));

    function filterMenu(type, btn) {
        document.querySelectorAll('.nav-pills .nav-link').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const rows = document.querySelectorAll('.menu-row');
        rows.forEach(row => {
            if (type === 'all' || row.getAttribute('data-type') === type) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // Submit Form Tambah via FormData
    document.getElementById('addMenuForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData();
        formData.append('name', document.getElementById('add_name').value);
        formData.append('category_id', document.getElementById('add_category_id').value);
        formData.append('price', document.getElementById('add_price').value);
        formData.append('status', document.getElementById('add_status').value);

        const fileInput = document.getElementById('add_image_file');
        if (fileInput.files.length > 0) {
            formData.append('image_file', fileInput.files[0]);
        }

        try {
            const res = await fetch('/admin/menu/create', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message || 'Gagal menambah menu');
            }
        } catch (err) {
            console.error(err);
            alert('Terjadi kesalahan koneksi');
        }
    });

    // Buka Modal Edit & Isikan Data
    function openEditModal(item) {
        document.getElementById('edit_id').value = item.id;
        document.getElementById('edit_name').value = item.name;
        document.getElementById('edit_category_id').value = item.category_id;
        document.getElementById('edit_price').value = item.price;
        document.getElementById('edit_existing_image').value = item.image || '';
        document.getElementById('edit_status').value = item.status;
        editModal.show();
    }

    // Submit Form Edit via FormData
    document.getElementById('editMenuForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('edit_id').value;
        const formData = new FormData();
        formData.append('name', document.getElementById('edit_name').value);
        formData.append('category_id', document.getElementById('edit_category_id').value);
        formData.append('price', document.getElementById('edit_price').value);
        formData.append('status', document.getElementById('edit_status').value);
        formData.append('existing_image', document.getElementById('edit_existing_image').value);

        const fileInput = document.getElementById('edit_image_file');
        if (fileInput.files.length > 0) {
            formData.append('image_file', fileInput.files[0]);
        }

        try {
            const res = await fetch(`/admin/menu/${id}/update`, {
                method: 'POST',
                body: formData
            });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message || 'Gagal mengubah menu');
            }
        } catch (err) {
            console.error(err);
            alert('Terjadi kesalahan koneksi');
        }
    });

    // Action Hapus Menu
    async function deleteMenu(id) {
        if (!confirm('Apakah Anda yakin ingin menghapus menu ini?')) return;
        try {
            const res = await fetch(`/admin/menu/${id}/delete`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message || 'Gagal menghapus menu');
            }
        } catch (err) {
            console.error(err);
            alert('Terjadi kesalahan koneksi');
        }
    }
</script>

</body>
</html>